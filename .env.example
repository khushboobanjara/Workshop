# Copy to .env and fill in real values. NEVER commit .env.

SESSION_SECRET=change-me-to-a-long-random-string
# Set to true when deployed behind HTTPS
SESSION_HTTPS_ONLY=false
# Public URL of the app (used for payment return URLs)
APP_BASE_URL=http://127.0.0.1:8000

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

GROQ_API_KEY=
GROQ_VISION_MODEL=

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=SANDBOX

GOOGLE_MAPS_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

# MCP layer (behaviour switches only - no secrets)
MCP_ENABLED=true
MCP_TOOL_TIMEOUT_SECONDS=15
MCP_MAX_ARGUMENT_BYTES=20000
MCP_RATE_LIMIT_PER_MINUTE=60
