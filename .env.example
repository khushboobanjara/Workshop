# Copy to .env and fill in real values. NEVER commit .env.

SESSION_SECRET=replace-with-a-long-random-secret
# Set to true when deployed behind HTTPS
SESSION_HTTPS_ONLY=false
# Public URL of the app (used for payment return URLs)
APP_BASE_URL=http://127.0.0.1:8000

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=

# USD per 1,000,000 tokens for GROQ_CHAT_MODEL=openai/gpt-oss-120b.
# Verify the provider's current pricing before deploying; rates may change.
# Groq model page (input $0.15, cached input $0.075, output $0.60):
# https://console.groq.com/docs/model/openai/gpt-oss-120b
LLM_INPUT_PRICE_PER_1M_USD=0.15
LLM_CACHED_INPUT_PRICE_PER_1M_USD=0.075
LLM_OUTPUT_PRICE_PER_1M_USD=0.60

# The vision model can have different rates. Leave blank to avoid mispricing it.
GROQ_VISION_INPUT_PRICE_PER_1M_USD=
GROQ_VISION_CACHED_INPUT_PRICE_PER_1M_USD=
GROQ_VISION_OUTPUT_PRICE_PER_1M_USD=

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=SANDBOX

GOOGLE_MAPS_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

# Role-specific MCP Bearer tokens. Generate unique values with:
# python scripts/generate_mcp_tokens.py
MCP_USER_TOKEN=
MCP_ADMIN_TOKEN=
MCP_SYSTEM_TOKEN=
MCP_SUPER_ADMIN_TOKEN=
