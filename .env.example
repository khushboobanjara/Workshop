# --- Database: MySQL 8.0.16+ (or MariaDB 10.5+). Copy this file to .env and fill in YOUR values; .env is git-ignored. ---
OPSPILOT_DB_HOST=127.0.0.1
OPSPILOT_DB_PORT=3306
OPSPILOT_DB_NAME=opspilot
OPSPILOT_DB_USER=opspilot
OPSPILOT_DB_PASSWORD=                   # required; any characters are fine (escaped for you)
# OPSPILOT_DB_SSL_CA=/path/to/ca.pem    # optional: require TLS to the server (recommended off-box / managed MySQL)
# OPSPILOT_DB_POOL_SIZE=10              # optional connection-pool tuning
# OPSPILOT_DB_MAX_OVERFLOW=20
# OPSPILOT_DATABASE_URL=                # optional: a full SQLAlchemy URL, e.g. mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4 (overrides the parts above)

# --- Test database (used only by pytest; its name MUST contain "test" because the tests drop and recreate its tables) ---
OPSPILOT_TEST_DB_HOST=127.0.0.1
OPSPILOT_TEST_DB_PORT=3306
OPSPILOT_TEST_DB_NAME=opspilot_test
OPSPILOT_TEST_DB_USER=opspilot
OPSPILOT_TEST_DB_PASSWORD=

# --- Docker Compose only: the bundled MySQL container's root password (never used by the app) ---
# MYSQL_ROOT_PASSWORD=


# --- Authentication (off by default for local development) ---
# OPSPILOT_AUTH_ENABLED=true
# OPSPILOT_JWT_SECRET=            # >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
# OPSPILOT_BOOTSTRAP_ADMIN_USER=admin          # creates the first admin on startup when no users exist
# OPSPILOT_BOOTSTRAP_ADMIN_PASSWORD=           # min 10 chars; remove these two lines after first start
# OPSPILOT_API_KEY=               # with auth on, this key lets the mail poller / folder watcher POST /emails and nothing else
# OPSPILOT_COOKIE_SECURE=true     # required when OPSPILOT_ENV=production (serve over HTTPS)
# OPSPILOT_ENV=production         # refuses to start without auth + secure cookies

# --- Model Context Protocol (MCP) server: read-only tools for AI assistants (docs/MCP.md). Off by default. ---
# Requires OPSPILOT_AUTH_ENABLED=true; refuses to start otherwise, and cannot be combined with demo mode.
# OPSPILOT_MCP_ENABLED=true
# OPSPILOT_MCP_SYSTEM_KEY=        # >= 32 random chars (python -c "import secrets; print(secrets.token_urlsafe(48))"); Bearer key of the read-only 'system' role. Must differ from OPSPILOT_API_KEY
# OPSPILOT_MCP_STDIO_TOKEN=       # only for `python -m app.mcp_server`: a user JWT (POST /auth/login) or the system key
# OPSPILOT_MCP_ALLOWED_ORIGINS=   # comma-separated browser origins allowed to call POST /mcp (empty = browsers refused; desktop/script clients send no Origin)
# OPSPILOT_MCP_RATE_LIMIT_PER_MINUTE=60
# OPSPILOT_MCP_MAX_MESSAGE_BYTES=65536

# --- AI assistant (Groq) on top of the MCP tools (docs/CHAT.md). Off by default. ---
# Requires OPSPILOT_AUTH_ENABLED=true; refuses to start otherwise or in demo mode. Questions and the records needed to answer them are sent to Groq.
# OPSPILOT_CHAT_ENABLED=true
# OPSPILOT_GROQ_API_KEY=          # create at https://console.groq.com/keys (starts with gsk_)
# OPSPILOT_GROQ_MODEL=openai/gpt-oss-120b   # any Groq model that supports tool calling
# OPSPILOT_CHAT_FACT_CHECK=true  # second model call that checks every statement against the records
# OPSPILOT_CHAT_RATE_LIMIT_PER_MINUTE=20
# OPSPILOT_CHAT_TIMEOUT_SECONDS=30
